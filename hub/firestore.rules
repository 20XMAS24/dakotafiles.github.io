rules_version = '2';
// Правила для проекта kentucky-economy: Firebase Console → Firestore Database → Rules.
// Хаб (/hub/) доступен только вошедшим. Экономика (/economy/) работает без входа, как раньше.
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Kentucky Hub ──
    // Отделы (depts) и отметку руководителя (admin) меняет только руководитель.
    // Первого руководителя назначают вручную: hub_people → свой документ → поле admin (boolean) = true.
    function meDoc() { return get(/databases/$(database)/documents/hub_people/$(request.auth.uid)).data; }
    function isAdmin() { return request.auth != null && meDoc().get('admin', false) == true; }
    function myDepts() { return meDoc().get('depts', []); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    match /hub_people/{uid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.auth.uid == uid
        && request.resource.data.get('depts', []).size() == 0
        && request.resource.data.get('admin', false) == false;
      allow update: if request.auth != null && (
        (request.auth.uid == uid && !changed().hasAny(['depts', 'admin']))
        || (isAdmin() && changed().hasOnly(['depts', 'admin'])));
    }
    // Задачи видят все. Меняют и удаляют участники отделов задачи, остальные могут только дописать комментарий.
    // Создать задачу для любого отдела может каждый.
    // dept — основной отдел, depts — все отделы задачи. Отделы перечислены явно: так база
    // может проверить запрос where('depts', 'array-contains', отдел).
    function shares(d) { return d in myDepts() && d in resource.data.get('depts', []); }
    function seesTask() {
      return resource.data.dept in myDepts()
        || shares('dev') || shares('cef') || shares('design') || shares('art3d') || shares('gd') || shares('econ')
        || shares('qa') || shares('release') || shares('admin') || shares('smm') || shares('donate') || shares('analytics');
    }
    function isComment() {
      let before = resource.data.get('comments', []);
      let after = request.resource.data.get('comments', []);
      return changed().hasOnly(['comments', 'updatedAt', 'updatedBy'])
        && after.size() == before.size() + 1
        && after[after.size() - 1].by == request.auth.uid;
    }
    match /hub_tasks/{id} {
      allow read, create: if request.auth != null;
      allow update: if request.auth != null && (seesTask() || isComment());
      allow delete: if request.auth != null && seesTask();
    }
    // Входящие личные: каждый видит и удаляет только свои
    match /hub_inbox/{id} {
      allow read, delete: if request.auth != null && resource.data.by == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
    }
    match /{coll}/{id} {
      allow read, write: if request.auth != null
        && coll in ['hub_decisions', 'hub_reg', 'hub_wiki', 'hub_log', 'hub_meta', 'hub_files', 'hub_fileparts', 'hub_chats', 'hub_msgs', 'hub_claude'];
    }

    // ── Экономика (/economy/) — без входа, только её коллекции ──
    // Если раньше здесь было условие (например, срок действия тестового режима), оставь его.
    match /{coll}/{id} {
      allow read, write: if coll in ['sections', 'params', 'bugs', 'stages', 'decisions', 'log', 'people', 'meta'];
    }
  }
}
